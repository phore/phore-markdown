{
  "name": "phore/markdown",
  "type": "library",
  "description": "Small dependency-free HTML and Markdown converters for PHP.",
  "license": "MIT",
  "authors": [
    {
      "name": "Matthias Leuffen",
      "email": "leuffen@continue.de"
    }
  ],
  "autoload": {
    "psr-4": {
      "Phore\\Markdown\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Phore\\Markdown\\Test\\": "test/"
    }
  },
  "require": {
    "php": ">=8.5",
    "ext-dom": "*",
    "ext-libxml": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.2"
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable"
}
